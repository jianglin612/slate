# Supabase - Get from: Supabase Dashboard > Project Settings > API
# Uses new key format: sb_publishable_ (anon) and sb_secret_ (service role)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-service-role-key

# JWT
JWT_SECRET=your-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Microsoft OAuth
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# Claude
ANTHROPIC_API_KEY=your-anthropic-api-key

# App URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Encryption key for OAuth tokens (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your-32-byte-hex-encryption-key
